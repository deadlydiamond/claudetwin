# Generate each token with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CLAUDETWIN_WORK_TOKEN=
CLAUDETWIN_PERSONAL_TOKEN=

# shared   = both accounts see all history and handoffs (default)
# isolated = each account sees only its own, plus items saved with visibility "shared"
CLAUDETWIN_MODE=shared

PORT=8787
DATA_DIR=./data
